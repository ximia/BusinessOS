# =============================================================================
# Environment variables. Copy to `.env.local` and fill in per deployment.
# =============================================================================

# Supabase — public keys are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service-role key: server-only. NEVER expose to the client. Used by admin
# server actions / route handlers that must bypass row level security.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# The canonical public URL of the site (used for SEO metadata, sitemap, OG).
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# Optional: where new-lead / contact notifications should be emailed.
LEAD_NOTIFICATION_EMAIL="owner@example.com"

# =============================================================================
# Agency OS connector (OPTIONAL). All unset ⇒ connector dormant and the
# read-only Agency API returns 503 "disabled". Business OS runs fully
# standalone regardless. See docs/API.md §2a and src/lib/agency/README.md.
# =============================================================================

# Master switch for the connector / Agency API. Leave false to stay standalone.
AGENCY_OS_ENABLED="false"

# Stable identities used to address this deployment (issued per clone/client).
BUSINESS_OS_DEPLOYMENT_ID=""
BUSINESS_OS_ORG_ID=""
BUSINESS_OS_ORG_SLUG=""

# Where Agency OS lives. Stored for later phases; UNUSED today (no outbound calls).
AGENCY_OS_BASE_URL=""

# Server-only shared secret Agency OS must present (Authorization: Bearer <key>)
# to call the read-only Agency API. NEVER expose to the client.
AGENCY_INBOUND_API_KEY=""

# Server-only shared secret Business OS presents to Agency OS when registering
# itself (outbound). NEVER expose to the client. Registration only runs when the
# connector is enabled AND base URL + deployment id + this key are all set;
# otherwise it is skipped and the app is unaffected.
AGENCY_OUTBOUND_API_KEY=""

# Optional override for the Agency OS registration endpoint path.
# Defaults to /api/v1/deployments/register.
AGENCY_OS_REGISTER_PATH=""

# Optional override for the Agency OS event-ingest endpoint path.
# Defaults to /api/v1/events. Events reuse AGENCY_OUTBOUND_API_KEY above.
AGENCY_OS_EVENTS_PATH=""
